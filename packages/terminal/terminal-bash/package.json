{
  "name": "@nero/nero-terminal-bash",
  "description": "Persistent shell PTY backend over the Nero Harness subprocess terminal primitive",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nero-ai/nero-harness.git",
    "directory": "packages/terminal/terminal-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@nero/nero-agent": "workspace:*",
    "@nero/nero-terminal": "workspace:*",
    "@nero/nero-sandbox": "workspace:*",
    "@nero/nero-sandbox-policy": "workspace:*",
    "@nero/nero-session": "workspace:*",
    "@nero/nero-subprocess": "workspace:*",
    "@nero/cordis": "workspace:~",
    "@nero/nero-session-projection": "workspace:*"
  },
  "dependencies": {
    "@nero/nero-lazy-require": "workspace:*",
    "@nero/nero-pwsh-local": "workspace:*",
    "@nero/schemastery": "workspace:~",
    "@xterm/headless": "^6.0.0"
  },
  "devDependencies": {
    "@nero/nero-agent": "workspace:*",
    "@nero/nero-agent-loop-testkit": "workspace:*",
    "@nero/nero-terminal": "workspace:*",
    "@nero/nero-sandbox": "workspace:*",
    "@nero/nero-sandbox-policy": "workspace:*",
    "@nero/nero-session": "workspace:*",
    "@nero/nero-subprocess": "workspace:*",
    "@nero/nero-subprocess-local": "workspace:*",
    "@nero/cordis": "workspace:~"
  }
}
