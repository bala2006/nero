{
  "name": "@nero/nero-web-search-nero",
  "description": "Nero-backed search provider (native web_search via the Anthropic-compatible API) for the Nero Harness web capability seam (ctx.web)",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nero-ai/nero-harness.git",
    "directory": "packages/web/web-search-nero"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@nero/nero-agent": "workspace:*",
    "@nero/nero-credentials": "workspace:*",
    "@nero/nero-launch-environment": "workspace:*",
    "@nero/nero-session": "workspace:*",
    "@nero/nero-web": "workspace:*",
    "@nero/cordis": "workspace:~"
  },
  "dependencies": {
    "@nero/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@nero/nero-agent": "workspace:*",
    "@nero/nero-credentials": "workspace:*",
    "@nero/nero-credentials-local": "workspace:*",
    "@nero/nero-launch-environment": "workspace:*",
    "@nero/nero-session": "workspace:*",
    "@nero/nero-web": "workspace:*",
    "@nero/cordis": "workspace:~",
    "@nero/nero-http-proxy": "workspace:*"
  }
}
