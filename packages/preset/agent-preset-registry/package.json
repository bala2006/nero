{
  "name": "@nero/nero-agent-preset-registry",
  "description": "Declarative Agent preset registry and profile-backed editing",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nero-ai/nero-harness.git",
    "directory": "packages/preset/agent-preset-registry"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./display": {
      "types": "./lib/types/display.d.ts",
      "default": "./lib/types/display.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@nero/cordis-plugin-loader": "workspace:~",
    "@nero/nero-agent": "workspace:*",
    "@nero/nero-invariants": "workspace:*",
    "@nero/nero-scope": "workspace:*",
    "@nero/nero-session": "workspace:*",
    "@nero/nero-session-projection": "workspace:*",
    "@nero/nero-settings": "workspace:*",
    "@nero/nero-system-prompt": "workspace:*",
    "@nero/nero-tools": "workspace:*",
    "@nero/nero-typert-protocol": "workspace:*",
    "@nero/cordis": "workspace:~"
  },
  "dependencies": {
    "@nero/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nero/nero-app-boot": "workspace:*",
    "@nero/cordis-plugin-group": "workspace:~",
    "@nero/cordis-plugin-include": "workspace:~",
    "@nero/cordis-plugin-loader": "workspace:~",
    "@nero/nero-agent": "workspace:*",
    "@nero/nero-agent-loop": "workspace:*",
    "@nero/nero-atomic-write": "workspace:*",
    "@nero/nero-invariants": "workspace:*",
    "@nero/nero-llm": "workspace:*",
    "@nero/nero-scope": "workspace:*",
    "@nero/nero-session": "workspace:*",
    "@nero/nero-session-projection": "workspace:*",
    "@nero/nero-settings": "workspace:*",
    "@nero/nero-system-prompt": "workspace:*",
    "@nero/nero-tools": "workspace:*",
    "@nero/nero-typert-protocol": "workspace:*",
    "@nero/cordis": "workspace:~",
    "@nero/nero-hmr": "workspace:*",
    "@nero/nero-sandbox": "workspace:*",
    "@nero/nero-sandbox-policy": "workspace:*",
    "@nero/nero-user-approval": "workspace:*",
    "@nero/nero-agent-preset": "workspace:*"
  }
}
