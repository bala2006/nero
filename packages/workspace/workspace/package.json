{
  "name": "@nero/nero-workspace",
  "description": "Workspace entity registry (ctx.workspaceRegistry): durable workspace records with validated session attachment over the domain data form for the Nero Harness",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nero-ai/nero-harness.git",
    "directory": "packages/workspace/workspace"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@nero/cordis": "workspace:~",
    "@nero/nero-invariants": "workspace:*",
    "@nero/nero-session": "workspace:*",
    "@nero/nero-session-persistence": "workspace:*",
    "@nero/nero-storage": "workspace:*",
    "@nero/nero-storage-domain": "workspace:*",
    "@nero/nero-typert-protocol": "workspace:*"
  },
  "dependencies": {
    "@nero/nero-brand": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nero/cordis": "workspace:~",
    "@nero/nero-invariants": "workspace:*",
    "@nero/nero-session": "workspace:*",
    "@nero/nero-session-persistence": "workspace:*",
    "@nero/nero-storage": "workspace:*",
    "@nero/nero-storage-domain": "workspace:*",
    "@nero/nero-typert-protocol": "workspace:*"
  }
}
