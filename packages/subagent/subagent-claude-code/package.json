{
  "name": "@nero/nero-subagent-claude-code",
  "description": "One-shot Claude Code subagent provider over the official Agent SDK",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nero-ai/nero-harness.git",
    "directory": "packages/subagent/subagent-claude-code"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "nero": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@nero/cordis": "workspace:~",
    "@nero/nero-llm": "workspace:*",
    "@nero/nero-session": "workspace:*",
    "@nero/nero-subagent": "workspace:*",
    "@nero/nero-subprocess": "workspace:*",
    "@nero/nero-timeout": "workspace:*"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.263",
    "@anthropic-ai/sdk": "0.93.0",
    "@nero/nero-brand": "workspace:*",
    "@nero/schemastery": "workspace:~",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nero/cordis": "workspace:~",
    "@nero/nero-agent": "workspace:*",
    "@nero/nero-app-boot": "workspace:*",
    "@nero/nero-llm": "workspace:*",
    "@nero/nero-loader-smoke": "workspace:*",
    "@nero/nero-session": "workspace:*",
    "@nero/nero-session-checkpoint-policy": "workspace:*",
    "@nero/nero-session-persistence-jsonl": "workspace:*",
    "@nero/nero-session-projection": "workspace:*",
    "@nero/nero-subagent": "workspace:*",
    "@nero/nero-subagent-codex": "workspace:*",
    "@nero/nero-subprocess": "workspace:*",
    "@nero/nero-subprocess-local": "workspace:*",
    "@nero/nero-timeout": "workspace:*",
    "@nero/nero-tool-jobs": "workspace:*",
    "@nero/nero-tool-subagent": "workspace:*",
    "@nero/nero-tools": "workspace:*"
  }
}
