{
  "name": "@nero/nero-subagent-nero-sdk",
  "description": "Out-of-process SDK subagent backend: drives a child Nero Harness runtime subprocess over stdio JSON-RPC through the TypeScript SDK client",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nero-ai/nero-harness.git",
    "directory": "packages/subagent/subagent-nero-sdk"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@nero/cordis": "workspace:~",
    "@nero/nero-agent": "workspace:*",
    "@nero/nero-llm": "workspace:*",
    "@nero/nero-sdk-client": "workspace:*",
    "@nero/nero-session": "workspace:*",
    "@nero/nero-subagent": "workspace:*",
    "@nero/nero-subprocess": "workspace:*"
  },
  "dependencies": {
    "@nero/nero-brand": "workspace:*",
    "@nero/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@nero/cordis": "workspace:~",
    "@nero/cordis-plugin-loader": "workspace:~",
    "@nero/nero-agent": "workspace:*",
    "@nero/nero-agent-instructions": "workspace:*",
    "@nero/nero-app-boot": "workspace:*",
    "@nero/nero-llm": "workspace:*",
    "@nero/nero-llm-nero": "workspace:*",
    "@nero/nero-loader-smoke": "workspace:*",
    "@nero/nero-sdk-client": "workspace:*",
    "@nero/nero-sdk-protocol": "workspace:*",
    "@nero/nero-session": "workspace:*",
    "@nero/nero-session-checkpoint-policy": "workspace:*",
    "@nero/nero-session-persistence-jsonl": "workspace:*",
    "@nero/nero-session-projection": "workspace:*",
    "@nero/nero-skill-filesystem": "workspace:*",
    "@nero/nero-subagent": "workspace:*",
    "@nero/nero-subprocess": "workspace:*",
    "@nero/nero-system-prompt": "workspace:*",
    "@nero/nero-tool-subagent": "workspace:*"
  }
}
