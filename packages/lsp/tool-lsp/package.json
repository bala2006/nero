{
  "name": "@nero/nero-tool-lsp",
  "description": "Model-facing lsp tool over the Nero Harness LSP capability seam (ctx.lsp) — one read-only tool with goToDefinition/findReferences/goToImplementation/hover operations, one-based UTF-16 cursor coordinates, bounded location rendering, and hover normalization",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nero-ai/nero-harness.git",
    "directory": "packages/lsp/tool-lsp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@nero/cordis": "workspace:~",
    "@nero/nero-llm": "workspace:*",
    "@nero/nero-lsp": "workspace:*",
    "@nero/nero-system-prompt": "workspace:*",
    "@nero/nero-timeout": "workspace:*",
    "@nero/nero-tools": "workspace:*"
  },
  "dependencies": {
    "@nero/nero-util-values": "workspace:*",
    "@nero/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@nero/cordis": "workspace:~",
    "@nero/nero-agent": "workspace:*",
    "@nero/nero-fs-local": "workspace:*",
    "@nero/nero-llm": "workspace:*",
    "@nero/nero-lsp": "workspace:*",
    "@nero/nero-lsp-stdio": "workspace:*",
    "@nero/nero-session": "workspace:*",
    "@nero/nero-subprocess-local": "workspace:*",
    "@nero/nero-system-prompt": "workspace:*",
    "@nero/nero-timeout": "workspace:*",
    "@nero/nero-tool-call-timeout-policy": "workspace:*",
    "@nero/nero-tools": "workspace:*"
  }
}
