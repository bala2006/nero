{
  "name": "@nero/nero-settings",
  "description": "Abstract user-settings seam (ctx.settings) for the Nero Harness",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nero-ai/nero-harness.git",
    "directory": "packages/settings/settings"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@nero/cordis": "workspace:~",
    "@nero/nero-brand": "workspace:*",
    "@nero/nero-invariants": "workspace:*",
    "@nero/nero-session": "workspace:*",
    "@nero/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@nero/cordis": "workspace:~",
    "@nero/nero-brand": "workspace:*",
    "@nero/nero-invariants": "workspace:*",
    "@nero/nero-session": "workspace:*",
    "@nero/schemastery": "workspace:~",
    "@nero/cordis-plugin-timer": "workspace:~",
    "@nero/nero-app-boot": "workspace:*",
    "@nero/nero-hmr": "workspace:*",
    "@nero/nero-agent-default-model": "workspace:*",
    "yaml": "^2.8.1"
  },
  "dependencies": {
    "@nero/nero-util-values": "workspace:*",
    "@nero/nero-config-editor": "workspace:*",
    "@nero/cordis-plugin-loader": "workspace:~",
    "@nero/cosmokit": "workspace:~",
    "yaml": "^2.8.1"
  }
}
