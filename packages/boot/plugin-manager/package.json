{
  "name": "@nero/nero-plugin-manager",
  "description": "Current-profile plugin and bundle management shared by nero CLI, Web and agent tools",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nero-ai/nero-harness.git",
    "directory": "packages/boot/plugin-manager"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./registry": {
      "types": "./lib/types/registry.d.ts",
      "default": "./lib/types/registry.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./operations": {
      "types": "./lib/types/operations.d.ts",
      "default": "./lib/types/operations.js"
    },
    "./tools": {
      "types": "./lib/types/tools.d.ts",
      "default": "./lib/types/tools.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@nero/nero-app-boot": "workspace:*",
    "@nero/nero-atomic-write": "workspace:*",
    "@nero/schemastery": "workspace:~",
    "execa": "^10.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "@nero/nero-util-values": "workspace:*"
  },
  "peerDependencies": {
    "@nero/cordis": "workspace:~",
    "@nero/cordis-plugin-loader": "workspace:~",
    "@nero/nero-host-plugin-inventory": "workspace:*",
    "@nero/nero-subprocess": "workspace:*",
    "@nero/nero-typert-protocol": "workspace:*",
    "@nero/nero-tools": "workspace:*",
    "@nero/nero-hmr": "workspace:*",
    "@nero/nero-brand": "workspace:*",
    "@nero/nero-sandbox-policy": "workspace:*",
    "@nero/nero-sandbox": "workspace:*",
    "@nero/nero-user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@nero/nero-hmr": {
      "optional": true
    },
    "@nero/nero-user-approval": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nero/nero-package-manifest": "workspace:*",
    "@nero/cordis": "workspace:~",
    "@nero/cordis-plugin-loader": "workspace:~",
    "@nero/nero-host-plugin-inventory": "workspace:*",
    "@nero/nero-subprocess": "workspace:*",
    "@nero/nero-typert-protocol": "workspace:*",
    "@nero/nero-tools": "workspace:*",
    "@nero/nero-system-prompt": "workspace:*",
    "@nero/nero-hmr": "workspace:*",
    "@nero/cordis-plugin-timer": "workspace:~",
    "@nero/nero-brand": "workspace:*",
    "@nero/nero-sandbox-policy": "workspace:*",
    "@nero/nero-agent": "workspace:*",
    "@nero/nero-session": "workspace:*",
    "@nero/nero-session-projection": "workspace:*",
    "@nero/nero-sandbox": "workspace:*",
    "@nero/nero-user-approval": "workspace:*"
  }
}
