{
  "name": "@nero/nero-sandbox-local",
  "description": "Local process-sandbox backends for the Nero Harness sandbox seam: bwrap, the npm-distributed landlock-run launcher, macOS Seatbelt, or the Windows ACL restricted-token runner — functionally probed, fail-closed",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nero-ai/nero-harness.git",
    "directory": "packages/sandbox/sandbox-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@nero/cordis": "workspace:~",
    "@nero/nero-llm": "workspace:*",
    "@nero/nero-sandbox": "workspace:*",
    "@nero/nero-session": "workspace:*"
  },
  "dependencies": {
    "@nero/nero-sandbox-windows-acl": "workspace:*",
    "@nero/nero-util-values": "workspace:*",
    "@nero/node-addon-system": "workspace:~",
    "@nero/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@nero/cordis": "workspace:~",
    "@nero/nero-llm": "workspace:*",
    "@nero/nero-sandbox": "workspace:*",
    "@nero/nero-session": "workspace:*"
  }
}
