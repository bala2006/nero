{
  "name": "@nero/nero-session-telemetry",
  "description": "SessionTelemetryBackend seam for the Nero Harness: session-event capture, projection, redaction, and handoff to a reporting backend",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nero-ai/nero-harness.git",
    "directory": "packages/session/session-telemetry"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
