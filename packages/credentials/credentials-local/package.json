{
  "name": "@nero/nero-credentials-local",
  "description": "File-backed credentials provider ($NERO_HOME/.env under the live process environment) for the Nero Harness",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nero-ai/nero-harness.git",
    "directory": "packages/credentials/credentials-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@nero/nero-atomic-write": "workspace:*",
    "@nero/nero-credentials": "workspace:*",
    "@nero/nero-launch-environment": "workspace:*",
    "@nero/nero-home-paths": "workspace:*",
    "@nero/cordis": "workspace:~"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "@nero/schemastery": "workspace:~",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@nero/nero-atomic-write": "workspace:*",
    "@nero/nero-credentials": "workspace:*",
    "@nero/nero-launch-environment": "workspace:*",
    "@nero/nero-home-paths": "workspace:*",
    "@nero/cordis": "workspace:~"
  }
}
