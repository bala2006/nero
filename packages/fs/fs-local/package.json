{
  "name": "@nero/nero-fs-local",
  "description": "Local-filesystem implementation of the Nero Harness filesystem seam (ctx.fs)",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nero-ai/nero-harness.git",
    "directory": "packages/fs/fs-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@nero/nero-fs": "workspace:*",
    "@nero/cordis": "workspace:~"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "koffi": "^3.1.0",
    "@nero/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@nero/nero-fs": "workspace:*",
    "@nero/nero-llm": "workspace:*",
    "@nero/cordis": "workspace:~"
  }
}
