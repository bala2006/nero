{
  "name": "@nero/nero-tool-fs-search",
  "description": "Model-facing filesystem discovery tools (glob, grep) backed by the packaged ripgrep binary (@vscode/ripgrep)",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nero-ai/nero-harness.git",
    "directory": "packages/fs/tool-fs-search"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0",
    "@nero/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@nero/nero-llm": "workspace:*",
    "@nero/nero-output-retention": "workspace:*",
    "@nero/nero-session": "workspace:*",
    "@nero/nero-spill": "workspace:*",
    "@nero/nero-subprocess": "workspace:*",
    "@nero/nero-system-prompt": "workspace:*",
    "@nero/nero-timeout": "workspace:*",
    "@nero/nero-tools": "workspace:*",
    "@nero/cordis": "workspace:~"
  },
  "devDependencies": {
    "@nero/nero-agent": "workspace:*",
    "@nero/nero-subprocess": "workspace:*",
    "@nero/nero-subprocess-local": "workspace:*",
    "@nero/nero-llm": "workspace:*",
    "@nero/nero-output-retention": "workspace:*",
    "@nero/nero-session": "workspace:*",
    "@nero/nero-spill": "workspace:*",
    "@nero/nero-system-prompt": "workspace:*",
    "@nero/nero-timeout": "workspace:*",
    "@nero/nero-tools": "workspace:*",
    "@nero/cordis": "workspace:~",
    "@nero/nero-scope": "workspace:*"
  }
}
