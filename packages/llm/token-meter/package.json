{
  "name": "@nero/nero-token-meter",
  "description": "Replay-aware token measurement service (ctx.tokenMeter) for the Nero Harness",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nero-ai/nero-harness.git",
    "directory": "packages/llm/token-meter"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./estimate": {
      "types": "./lib/types/estimate.d.ts",
      "default": "./lib/types/estimate.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@nero/cordis": "workspace:~",
    "@nero/nero-compaction": "workspace:*",
    "@nero/nero-llm": "workspace:*",
    "@nero/nero-llm-retry": "workspace:*",
    "@nero/nero-session": "workspace:*",
    "@nero/nero-session-projection": "workspace:*",
    "@nero/nero-compaction-image-offload": "workspace:*"
  },
  "dependencies": {
    "@nero/nero-util-values": "workspace:*",
    "@nero/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nero/cordis": "workspace:~",
    "@nero/nero-compaction": "workspace:*",
    "@nero/nero-llm": "workspace:*",
    "@nero/nero-llm-retry": "workspace:*",
    "@nero/nero-session": "workspace:*",
    "@nero/nero-session-projection": "workspace:*",
    "@nero/nero-compaction-image-offload": "workspace:*"
  }
}
