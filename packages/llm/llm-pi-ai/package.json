  },
  "devDependencies": {
    "@nero/cordis": "workspace:~",
    "@nero/nero-attachment": "workspace:*",
    "@nero/nero-authorization": "workspace:*",
    "@nero/nero-credentials": "workspace:*",
    "@nero/nero-fs": "workspace:*",
    "@nero/nero-launch-environment": "workspace:*",
    "@nero/nero-llm": "workspace:*",
    "@nero/nero-llm-nero": "workspace:*",
    "@nero/nero-timeout": "workspace:*",
    "@nero/nero-http-proxy": "workspace:*",
    "@nero/cordis-plugin-loader": "workspace:~",
