{
  "name": "@nero/nero-ptc-runtime-node",
  "description": "Sandboxed Node process implementation of the Nero Harness PTC execution capability",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nero-ai/nero-harness.git",
    "directory": "packages/ptc-runtime/ptc-runtime-node"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./process": {
      "types": "./lib/types/process-entry.d.ts",
      "default": "./lib/process.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/process.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@nero/cordis": "workspace:~",
    "@nero/nero-ptc-runtime": "workspace:*",
    "@nero/nero-session": "workspace:*",
    "@nero/nero-timeout": "workspace:*",
    "@nero/nero-fs": "workspace:*",
    "@nero/nero-subprocess": "workspace:*",
    "@nero/nero-sandbox": "workspace:*",
    "@nero/nero-sandbox-policy": "workspace:*"
  },
  "dependencies": {
    "@nero/nero-util-values": "workspace:*",
    "@nero/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@nero/cordis": "workspace:~",
    "@nero/nero-ptc-runtime": "workspace:*",
    "@nero/nero-session": "workspace:*",
    "@nero/nero-timeout": "workspace:*",
    "@nero/nero-fs": "workspace:*",
    "@nero/nero-subprocess": "workspace:*",
    "@nero/nero-sandbox": "workspace:*",
    "@nero/nero-sandbox-policy": "workspace:*",
    "@nero/nero-fs-local": "workspace:*",
    "@nero/nero-subprocess-local": "workspace:*",
    "@nero/nero-session-projection": "workspace:*",
    "@nero/nero-sandbox-local": "workspace:*"
  }
}
