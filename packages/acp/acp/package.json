{
  "name": "@nero/nero-acp",
  "description": "Automation-only Agent Client Protocol server for driving Nero Harness agents over JSON-RPC stdio",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nero-ai/nero-harness.git",
    "directory": "packages/acp/acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@nero/nero-brand": "workspace:*",
    "@nero/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@nero/cordis": "workspace:~",
    "@nero/nero-agent": "workspace:*",
    "@nero/nero-attachment": "workspace:*",
    "@nero/nero-llm": "workspace:*",
    "@nero/nero-mcp-client": "workspace:*",
    "@nero/nero-session": "workspace:*",
    "@nero/nero-session-persistence": "workspace:*",
    "@nero/nero-token-meter": "workspace:*",
    "@nero/nero-user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@nero/nero-token-meter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nero/cordis": "workspace:~",
    "@nero/nero-agent": "workspace:*",
    "@nero/nero-agent-loop": "workspace:*",
    "@nero/nero-agent-loop-testkit": "workspace:*",
    "@nero/nero-attachment": "workspace:*",
    "@nero/nero-llm": "workspace:*",
    "@nero/nero-mcp-client": "workspace:*",
    "@nero/nero-session": "workspace:*",
    "@nero/nero-session-persistence": "workspace:*",
    "@nero/nero-session-persistence-jsonl": "workspace:*",
    "@nero/nero-session-projection": "workspace:*",
    "@nero/nero-token-meter": "workspace:*",
    "@nero/nero-tools": "workspace:*",
    "@nero/nero-user-approval": "workspace:*"
  }
}
