{
  "name": "@nero/nero-bash-local",
  "description": "Local-subprocess implementation of the Nero Harness bash executor seam",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nero-ai/nero-harness.git",
    "directory": "packages/shell/bash-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@nero/nero-shell": "workspace:*",
    "@nero/nero-subprocess": "workspace:*",
    "@nero/nero-timeout": "workspace:*",
    "@nero/cordis": "workspace:~"
  },
  "dependencies": {
    "@nero/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@nero/nero-shell": "workspace:*",
    "@nero/nero-subprocess": "workspace:*",
    "@nero/nero-subprocess-local": "workspace:*",
    "@nero/nero-timeout": "workspace:*",
    "@nero/cordis": "workspace:~"
  }
}
