{
  "name": "@nero/nero-headless",
  "description": "The nero one-shot bundle: a direct core Agent/Session runner over nero-base with no Host, HTTP, or browser layer",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nero-ai/nero-harness.git",
    "directory": "packages/bundle/headless"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/startup.js",
    "cordis.patch.yml",
    "lib/json-stream-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "nero": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@nero/nero-brand": "workspace:*",
    "@nero/nero-cmdline": "workspace:*",
    "@nero/nero-util-values": "workspace:*",
    "@nero/schemastery": "workspace:~",
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@nero/cordis": "workspace:~",
    "@nero/cordis-plugin-loader": "workspace:~",
    "@nero/nero-agent": "workspace:*",
    "@nero/nero-agent-default-model": "workspace:*",
    "@nero/nero-llm": "workspace:*",
    "@nero/nero-session": "workspace:*",
    "@nero/nero-session-query": "workspace:*",
    "@nero/nero-fs": "workspace:*"
  },
  "devDependencies": {
    "@nero/cordis": "workspace:~",
    "@nero/cordis-plugin-loader": "workspace:~",
    "@nero/nero-agent": "workspace:*",
    "@nero/nero-agent-default-model": "workspace:*",
    "@nero/nero-agent-loop": "workspace:*",
    "@nero/nero-agent-loop-testkit": "workspace:*",
    "@nero/nero-llm": "workspace:*",
    "@nero/nero-session": "workspace:*",
    "@nero/nero-session-query": "workspace:*",
    "@nero/nero-fs": "workspace:*"
  }
}
