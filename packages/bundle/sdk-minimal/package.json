{
  "name": "@nero/nero-sdk-minimal",
  "description": "The standalone minimal SDK profile bundle: JSON-RPC, one Nero adapter, persistent shell, and JSONL sessions",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nero-ai/nero-harness.git",
    "directory": "packages/bundle/sdk-minimal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "nero": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@nero/cordis-plugin-timer": "workspace:~",
    "@nero/nero-agent": "workspace:*",
    "@nero/nero-agent-loop": "workspace:*",
    "@nero/nero-nero-llm-api-extensions": "workspace:*",
    "@nero/nero-invariants": "workspace:*",
    "@nero/nero-jobs-local": "workspace:*",
    "@nero/nero-llm": "workspace:*",
    "@nero/nero-llm-retry": "workspace:*",
    "@nero/nero-mcp-resources": "workspace:*",
    "@nero/nero-plugin-package-inventory-nero": "workspace:*",
    "@nero/nero-sandbox-local": "workspace:*",
    "@nero/nero-sandbox-policy": "workspace:*",
    "@nero/nero-scope": "workspace:*",
    "@nero/nero-sdk-app": "workspace:*",
    "@nero/nero-sdk-jsonrpc-server": "workspace:*",
    "@nero/nero-session": "workspace:*",
    "@nero/nero-session-log-nero": "workspace:*",
    "@nero/nero-session-persistence-jsonl": "workspace:*",
    "@nero/nero-session-projection": "workspace:*",
    "@nero/nero-session-title": "workspace:*",
    "@nero/nero-subprocess-local": "workspace:*",
    "@nero/nero-system-prompt": "workspace:*",
    "@nero/nero-terminal": "workspace:*",
    "@nero/nero-terminal-bash": "workspace:*",
    "@nero/nero-tool-bash-persistent": "workspace:*",
    "@nero/nero-tool-pwsh-persistent": "workspace:*",
    "@nero/nero-tools": "workspace:*"
  },
  "peerDependencies": {
    "@nero/cordis": "workspace:~"
  },
  "devDependencies": {
    "@nero/cordis": "workspace:~"
  }
}
