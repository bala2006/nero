{
  "name": "@nero/nero-sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process Nero Harness SDK clients",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nero-ai/nero-harness.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@nero/nero-brand": "workspace:*",
    "@nero/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@nero/cordis": "workspace:~",
    "@nero/nero-agent": "workspace:*",
    "@nero/nero-attachment": "workspace:*",
    "@nero/nero-llm": "workspace:*",
    "@nero/nero-llm-nero": "workspace:*",
    "@nero/nero-scope": "workspace:*",
    "@nero/nero-sdk-protocol": "workspace:*",
    "@nero/nero-session": "workspace:*",
    "@nero/nero-subagent": "workspace:*"
  },
  "devDependencies": {
    "@nero/cordis": "workspace:~",
    "@nero/cordis-plugin-loader": "workspace:~",
    "@nero/nero-agent": "workspace:*",
    "@nero/nero-agent-loop": "workspace:*",
    "@nero/nero-agent-loop-testkit": "workspace:*",
    "@nero/nero-attachment": "workspace:*",
    "@nero/nero-llm": "workspace:*",
    "@nero/nero-llm-nero": "workspace:*",
    "@nero/nero-scope": "workspace:*",
    "@nero/nero-sdk-protocol": "workspace:*",
    "@nero/nero-session": "workspace:*",
    "@nero/nero-session-persistence-jsonl": "workspace:*",
    "@nero/nero-session-projection": "workspace:*",
    "@nero/nero-subagent": "workspace:*"
  }
}
