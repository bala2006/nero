{
  "name": "@nero/nero-sdk-client",
  "description": "TypeScript client SDK for driving a Nero Harness runtime subprocess over stdio JSON-RPC: the NeroHarness high-level turns API and the lower-level HarnessClient",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nero-ai/nero-harness.git",
    "directory": "packages/sdk/client"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@nero/nero": "workspace:*"
  },
  "peerDependencies": {
    "@nero/nero-llm": "workspace:*",
    "@nero/nero-sdk-protocol": "workspace:*",
    "@nero/nero-session": "workspace:*",
    "@nero/cordis": "workspace:~"
  },
  "devDependencies": {
    "@nero/nero-llm": "workspace:*",
    "@nero/nero-sdk-protocol": "workspace:*",
    "@nero/nero-session": "workspace:*",
    "@nero/cordis": "workspace:~"
  }
}
