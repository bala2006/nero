{
  "name": "@nero/nero-api-remotes",
  "description": "Remote BFF assembly for application-selected Host capabilities",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nero-ai/nero-harness.git",
    "directory": "packages/api/remotes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "nero": {
    "client": {
      "inject": [
        "@nero/nero-api-gateway"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@nero/nero-deque": "workspace:*",
    "@nero/nero-session": "workspace:*",
    "@nero/nero-util-values": "workspace:*"
  },
  "peerDependencies": {
    "@nero/cordis": "workspace:~",
    "@nero/nero-scope": "workspace:*"
  },
  "devDependencies": {
    "@nero/cordis": "workspace:~",
    "@nero/nero-agent": "workspace:*",
    "@nero/nero-client-ui-sidebar-browser": "workspace:*",
    "@nero/nero-agent-preset-registry": "workspace:*",
    "@nero/nero-api-gateway": "workspace:*",
    "@nero/nero-api-job-controller": "workspace:*",
    "@nero/nero-api-session-controller": "workspace:*",
    "@nero/nero-api-settings-controller": "workspace:*",
    "@nero/nero-api-workspace-controller": "workspace:*",
    "@nero/nero-client-connection": "workspace:*",
    "@nero/nero-client-file-upload": "workspace:*",
    "@nero/nero-commands": "workspace:*",
    "@nero/nero-cordis-host-runner": "workspace:*",
    "@nero/nero-credentials": "workspace:*",
    "@nero/nero-file-reference": "workspace:*",
    "@nero/nero-goal": "workspace:*",
    "@nero/nero-host-plugin-inventory": "workspace:*",
    "@nero/nero-llm": "workspace:*",
    "@nero/nero-message-feedback": "workspace:*",
    "@nero/nero-scope": "workspace:*",
    "@nero/nero-permission-presets": "workspace:*",
    "@nero/nero-session-reference": "workspace:*",
    "@nero/nero-settings": "workspace:*",
    "@nero/nero-subagent": "workspace:*",
    "@nero/nero-typert-protocol": "workspace:*",
    "@nero/nero-user-approval": "workspace:*",
    "@nero/nero-user-questions": "workspace:*",
    "@nero/nero-client-connection": "workspace:*",
    "@nero/nero-client-file-upload": "workspace:*",
    "@nero/nero-typert-protocol": "workspace:*",
    "@nero/nero-scope": "workspace:*",
    "@nero/nero-api-session-controller": "workspace:*",
    "@nero/nero-api-workspace-files": "workspace:*",
    "zod": "^4.4.3",
    "@nero/nero-command-feedback": "workspace:*",
    "@nero/nero-api-terminal-controller": "workspace:*",
    "@nero/nero-plugin-manager": "workspace:*",
    "@nero/nero-client-ui-plugin-manager": "workspace:*",
    "@nero/nero-office-to-pdf": "workspace:*",
    "@nero/nero-api-account-controller": "workspace:*"
  }
}
