{
  "name": "@nero/nero-schedule",
  "description": "Agent-scoped durable after, at, and fixed-rate reminders over the session event log",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nero-ai/nero-harness.git",
    "directory": "packages/schedule/schedule"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@nero/nero-agent": "workspace:*",
    "@nero/nero-brand": "workspace:*",
    "@nero/nero-invariants": "workspace:*",
    "@nero/nero-llm": "workspace:*",
    "@nero/nero-session": "workspace:*",
    "@nero/nero-session-persistence": "workspace:*",
    "@nero/nero-session-projection": "workspace:*",
    "@nero/nero-tools": "workspace:*",
    "@nero/nero-workspace": "workspace:*",
    "@nero/cordis": "workspace:~"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nero/cordis-plugin-loader": "workspace:~",
    "@nero/nero-agent": "workspace:*",
    "@nero/nero-agent-loop": "workspace:*",
    "@nero/nero-agent-loop-testkit": "workspace:*",
    "@nero/nero-brand": "workspace:*",
    "@nero/nero-invariants": "workspace:*",
    "@nero/nero-llm": "workspace:*",
    "@nero/nero-session": "workspace:*",
    "@nero/nero-session-persistence": "workspace:*",
    "@nero/nero-session-persistence-jsonl": "workspace:*",
    "@nero/nero-session-projection": "workspace:*",
    "@nero/nero-system-prompt": "workspace:*",
    "@nero/nero-tools": "workspace:*",
    "@nero/nero-workspace": "workspace:*",
    "@nero/cordis": "workspace:~"
  }
