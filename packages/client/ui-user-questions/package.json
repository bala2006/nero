{
  "name": "@nero/nero-client-ui-user-questions",
  "description": "Web ask_user_question composer takeover and plan-review presentation UI",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nero-ai/nero-harness.git",
    "directory": "packages/client/ui-user-questions"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "nero": {
    "client": {
      "inject": [
        "@nero/nero-api-remotes",
        "@nero/nero-api-session-controller",
        "@nero/nero-client-locale",
        "@nero/nero-client-ui-conversation",
        "@nero/nero-client-ui-renderer",
        "@nero/nero-client-ui-session"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@nero/cordis": "workspace:~"
  },
  "devDependencies": {
    "@nero/cordis": "workspace:~",
    "@nero/nero-agent": "workspace:*",
    "@nero/nero-api-remotes": "workspace:*",
    "@nero/nero-api-session-controller": "workspace:*",
    "@nero/nero-client-locale": "workspace:*",
    "@nero/nero-client-store": "workspace:*",
    "@nero/nero-system-prompt": "workspace:*",
    "@nero/nero-tools": "workspace:*",
    "@nero/nero-user-questions": "workspace:*",
    "@types/react": "~18.3.1",
    "@nero/nero-client-ui-primitives": "workspace:*",
    "@nero/nero-client-ui-slots": "workspace:*",
    "@nero/nero-client-ui-renderer": "workspace:*",
    "@nero/nero-client-ui-session": "workspace:*",
    "@nero/nero-typert-protocol": "workspace:*",
    "react": "^18.2.0",
    "@nero/nero-client-ui-conversation": "workspace:*",
    "@nero/nero-client-connection": "workspace:*",
    "@nero/nero-session": "workspace:*",
    "clsx": "^2.0.0",
    "@nero/nero-llm": "workspace:*"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
