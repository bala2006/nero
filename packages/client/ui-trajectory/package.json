{
  "name": "@nero/nero-client-ui-trajectory",
  "description": "Trajectory event ledger with an interactive timing overview: pure-consumer plugin registering into the conversation ViewMap (no service)",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nero-ai/nero-harness.git",
    "directory": "packages/client/ui-trajectory"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "nero": {
    "client": {
      "inject": [
        "@nero/nero-api-session-controller",
        "@nero/nero-client-locale",
        "@nero/nero-client-ui-conversation",
        "@nero/nero-client-ui-renderer",
        "@nero/nero-client-ui-session"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@nero/cordis": "workspace:~"
  },
  "devDependencies": {
    "@nero/nero-agent": "workspace:*",
    "@nero/nero-client-locale": "workspace:*",
    "@nero/nero-client-test-runtime": "workspace:*",
    "@nero/nero-client-ui-primitives": "workspace:*",
    "@nero/nero-client-ui-conversation": "workspace:*",
    "@nero/nero-client-ui-slots": "workspace:*",
    "@nero/nero-compaction": "workspace:*",
    "@nero/nero-tools": "workspace:*",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@nero/cordis": "workspace:~",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@nero/nero-client-store": "workspace:*",
    "@nero/nero-client-ui-chat": "workspace:*",
    "@nero/nero-session": "workspace:*",
    "@nero/nero-api-session-controller": "workspace:*",
    "@nero/nero-client-ui-renderer": "workspace:*",
    "@nero/nero-client-ui-session": "workspace:*",
    "@nero/nero-llm": "workspace:*",
    "@nero/nero-attachment": "workspace:*",
    "@tanstack/react-virtual": "^3.14.9",
    "diff": "^9.0.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
