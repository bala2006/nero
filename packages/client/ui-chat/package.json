{
  "name": "@nero/nero-client-ui-chat",
  "description": "Chat Conversation target, node definitions, renderers, and details surface",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nero-ai/nero-harness.git",
    "directory": "packages/client/ui-chat"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "nero": {
    "client": {
      "inject": [
        "@nero/nero-api-session-controller",
        "@nero/nero-api-workspace-controller",
        "@nero/nero-client-locale",
        "@nero/nero-client-ui-conversation",
        "@nero/nero-client-ui-input-trigger",
        "@nero/nero-client-ui-layout",
        "@nero/nero-client-ui-renderer",
        "@nero/nero-client-ui-session",
        "@nero/nero-client-ui-settings",
        "@nero/nero-client-ui-sidebar-right",
        "@nero/nero-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@nero/cordis": "workspace:~"
  },
  "devDependencies": {
    "@nero/cordis": "workspace:~",
    "@nero/nero-agent": "workspace:*",
    "@nero/nero-api-remotes": "workspace:*",
    "@nero/nero-api-session-controller": "workspace:*",
    "@nero/nero-api-workspace-controller": "workspace:*",
    "@nero/nero-api-workspace-files": "workspace:*",
    "@nero/nero-attachment": "workspace:*",
    "@nero/nero-brand": "workspace:*",
    "@nero/nero-client-locale": "workspace:*",
    "@nero/nero-client-store": "workspace:*",
    "@nero/nero-client-ui-approval": "workspace:*",
    "@nero/nero-client-ui-conversation": "workspace:*",
    "@nero/nero-client-ui-input-trigger": "workspace:*",
    "@nero/nero-client-ui-layout": "workspace:*",
    "@nero/nero-client-ui-primitives": "workspace:*",
    "@nero/nero-client-ui-renderer": "workspace:*",
    "@nero/nero-client-ui-session": "workspace:*",
    "@nero/nero-client-ui-settings": "workspace:*",
    "@nero/nero-client-ui-sidebar-browser": "workspace:*",
    "@nero/nero-client-ui-sidebar-documentpreview": "workspace:*",
    "@nero/nero-client-ui-sidebar-right": "workspace:*",
    "@nero/nero-client-ui-slots": "workspace:*",
    "@nero/nero-client-ui-workspace": "workspace:*",
    "@nero/nero-commands": "workspace:*",
    "@nero/nero-compaction": "workspace:*",
    "@nero/nero-llm": "workspace:*",
    "@nero/nero-llm-retry": "workspace:*",
    "@nero/nero-session": "workspace:*",
    "@nero/nero-session-stats": "workspace:*",
    "@nero/nero-session-turn-outline": "workspace:*",
    "@nero/nero-subagent": "workspace:*",
    "@nero/nero-token-meter": "workspace:*",
    "@nero/nero-tools": "workspace:*",
    "@nero/nero-util-workspace-path": "workspace:*",
    "@nero/nero-util-values": "workspace:*",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@nero/nero-settings": "workspace:*"
  },
  "dependencies": {
    "@nero/schemastery": "workspace:~"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
