{
  "name": "@nero/nero-tool-call-timeout-policy",
  "description": "Tool-call timeout policy: a tools/execute wrapper that arms a per-tool deadline on exec.signal and returns TOOL_TIMEOUT when it wins",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nero-ai/nero-harness.git",
    "directory": "packages/guard/timeout-policy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@nero/nero-llm": "workspace:*",
    "@nero/nero-timeout": "workspace:*",
    "@nero/nero-tools": "workspace:*",
    "@nero/cordis": "workspace:~"
  },
  "devDependencies": {
    "@nero/nero-llm": "workspace:*",
    "@nero/nero-timeout": "workspace:*",
    "@nero/nero-tools": "workspace:*",
    "@nero/cordis": "workspace:~"
  }
}
