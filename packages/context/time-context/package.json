{
  "name": "@nero/nero-time-context",
  "description": "Opt-in durable per-step context with the current time and elapsed time",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nero-ai/nero-harness.git",
    "directory": "packages/context/time-context"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@nero/nero-util-values": "workspace:*",
    "@nero/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@nero/cordis": "workspace:~",
    "@nero/nero-agent": "workspace:*",
    "@nero/nero-invariants": "workspace:*",
    "@nero/nero-llm": "workspace:*",
    "@nero/nero-session": "workspace:*",
    "@nero/nero-session-projection": "workspace:*"
  },
  "devDependencies": {
    "@nero/cordis": "workspace:~",
    "@nero/nero-agent": "workspace:*",
    "@nero/nero-agent-loop": "workspace:*",
    "@nero/nero-agent-loop-testkit": "workspace:*",
    "@nero/nero-app-boot": "workspace:*",
    "@nero/nero-bash-local": "workspace:*",
    "@nero/nero-invariants": "workspace:*",
    "@nero/nero-llm": "workspace:*",
    "@nero/nero-loader-smoke": "workspace:*",
    "@nero/nero-session": "workspace:*",
    "@nero/nero-session-checkpoint-policy": "workspace:*",
    "@nero/nero-session-persistence-jsonl": "workspace:*",
    "@nero/nero-session-projection": "workspace:*",
    "@nero/nero-subprocess-local": "workspace:*",
    "@nero/nero-system-prompt": "workspace:*",
    "@nero/nero-tools": "workspace:*"
  }
}
